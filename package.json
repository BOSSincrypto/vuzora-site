{
  "name": "vuzora-site",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/prepare-release.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/ensure-test-artifacts.mjs && node --test scripts/*.test.mjs",
    "test:browser:mobile-menu": "node scripts/mobile-menu-browser-regression.mjs",
    "test:browser:blog-metadata": "node scripts/blog-metadata-browser-regression.mjs",
    "test:browser:unknown-route-metadata": "node scripts/unknown-route-metadata-browser-regression.mjs",
    "generate:md": "node scripts/generate-markdown-mirrors.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:rss": "node scripts/generate-rss.mjs",
    "generate:agent-skills": "node scripts/generate-agent-skills.mjs",
    "generate:agent-card": "node scripts/generate-agent-card.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:browser:webmcp": "node scripts/webmcp-browser-regression.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "compare:release": "node scripts/compare-release.mjs",
    "repeat:release": "node scripts/repeat-release.mjs",
    "finalize:release": "node scripts/finalize-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.20",
    "@tanstack/react-start": "^1.168.37",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "//overrides": "Transitive advisories whose upstream ranges still pin a vulnerable patch. Build/dev-chain only — neither package reaches the browser bundle — so these are patch-level floors, not version bumps. `brace-expansion` is deliberately NOT floored here: the tree holds both 1.1.16 (via eslint) and 5.0.8 (via typescript-eslint), Bun does not support nested overrides, and a flat range would downgrade the newer line to satisfy the older one. The advisory is a DoS reachable only through hostile glob input, which lint tooling in this repo never receives.",
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
